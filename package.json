{
  "name": "website-proyecto-colombia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd ../backend-proyecto-colombia && npm run dev",
    "dev:local": "bash scripts/start-local-dev.sh",
    "dev:stopLocal": "bash scripts/stop-local-dev.sh",
    "build": "next build",
    "build:local": "NEXT_PUBLIC_API_URL=\"${NEXT_PUBLIC_API_URL:-http://localhost:4000/api/listings}\" next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build:local",
    "validate:clean": "npm ci && npm run validate"
  },
  "dependencies": {
    "lucide-react": "^0.428.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
