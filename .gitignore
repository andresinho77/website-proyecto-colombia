node_modules/
.next/
out/
build/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files. Committing a .env would silently override the local-safe
# NEXT_PUBLIC_API_URL fallback and defeat the fail-fast production build guard
# (see README -> "NEXT_PUBLIC_API_URL contract").
.env
.env*.local

# OpenWolf Local Runtime Data (Ignore transient session state & logs)
.wolf/_scan-state.json
.wolf/token-ledger.json
.wolf/buglog.json
.wolf/cron-state.json
.wolf/memory.md
.wolf/STATUS.md
.wolf/hooks/_session.json
_precompact-snapshot.json
.codex/

# Output of `npm run validate` (typecheck / lint / test steps)
# build output (.next/, out/) is already covered above
*.tsbuildinfo
.eslintcache
coverage/

# Playwright output (`npm run test:e2e`)
playwright-report/
test-results/
blob-report/
.playwright/

# Local agent settings (repo tracks .claude/settings.json only)
.claude/settings.local.json
