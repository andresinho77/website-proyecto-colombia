# Public API base URL used by the Next.js frontend
NEXT_PUBLIC_API_URL=https://api.alojamientosolidario.co/api/listings

# Optional: Cloudflare Turnstile site key for client-side verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Cloudflare Turnstile secret key for server-side verification
TURNSTILE_SECRET_KEY=

# Optional: S3-compatible upload config used by the upload flow
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=
S3_UPLOAD_ACCESS_KEY_ID=
S3_UPLOAD_SECRET_ACCESS_KEY=
S3_UPLOAD_URL_EXPIRY_SECONDS=900
